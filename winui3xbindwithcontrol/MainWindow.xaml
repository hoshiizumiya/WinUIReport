<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="winui3xbindwithcontrol.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:winui3xbindwithcontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="winui3xbindwithcontrol"
    mc:Ignorable="d">

    <StackPanel>
        <!--  No IDL declaration for either source: compare OneWay with TwoWay.  -->
        <ComboBox
            x:Name="OneWaySource"
            Header="OneWay source"
            SelectedIndex="0">
            <ComboBoxItem Content="A" />
            <ComboBoxItem Content="B" />
        </ComboBox>
        <ComboBox Header="OneWay target" SelectedIndex="{x:Bind OneWaySource.SelectedIndex, Mode=OneWay}">
            <ComboBoxItem Content="A" />
            <ComboBoxItem Content="B" />
        </ComboBox>
        <ComboBox
            x:Name="TwoWaySource"
            Header="TwoWay source"
            SelectedIndex="0">
            <ComboBoxItem Content="A" />
            <ComboBoxItem Content="B" />
        </ComboBox>
        <ComboBox Header="TwoWay target" SelectedIndex="{x:Bind TwoWaySource.SelectedIndex, Mode=TwoWay}">
            <ComboBoxItem Content="A" />
            <ComboBoxItem Content="B" />
        </ComboBox>
    </StackPanel>
</Window>
