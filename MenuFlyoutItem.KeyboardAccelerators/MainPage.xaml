<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MenuFlyoutItem.KeyboardAccelerators.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MenuFlyoutItem.KeyboardAccelerators"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid>
        <Button
            Width="100"
            Height="100"
            HorizontalAlignment="Right"
            Content="Edit Options">
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="FlyoutItem1"
                        Icon="Copy"
                        Text="Copy">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="C"
                                x:Name="Test"
                                Invoked="Test_Invoked"
                                Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Page>
