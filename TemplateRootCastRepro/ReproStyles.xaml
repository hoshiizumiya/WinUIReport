<ResourceDictionary
    x:Class="TemplateRootCastRepro.ReproStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TemplateRootCastRepro">
    <Style TargetType="local:ReproCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ReproCard">
                    <Border Padding="12" BorderBrush="Gray" BorderThickness="1">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Opacity="{x:Bind Opacity, Mode=OneWay}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
